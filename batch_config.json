{
  "project_name": "codex_ready_absolute_batch_workflow",
  "competitor_dir": "C:\\Users\\admin\\Desktop\\拼多多产品数据整理\\EnterImage",
  "product_dir": "C:\\Users\\admin\\Desktop\\拼多多产品数据整理\\ProductImage",
  "output_dir": "C:\\Users\\admin\\Desktop\\拼多多产品数据整理\\OutputIamge",
  "records_dir": "run_records",
  "tasks_dir": "tasks",
  "history_dir": "history",
  "run_cleanup": {
    "enabled": true,
    "archive_records_before_cleanup": true,
    "clear_tasks": true,
    "clear_output": true,
    "clear_records": true,
    "record_extensions": [".json", ".md", ".txt", ".csv", ".log"]
  },
  "image_extensions": [".png", ".jpg", ".jpeg", ".webp", ".bmp"],
  "match_mode": "auto",
  "allow_single_product_for_all": true,
  "allow_fallback_product": false,
  "fallback_product": "default.png",
  "skip_unmatched": true,
  "naming_mode": "competitor",
  "generate_analysis_file": true,
  "generate_prompt_file": true,
  "generate_qa_file": true,
  "generate_layout_spec": true,
  "generate_execution_log": true,
  "generate_batch_execution_summary": true,
  "output_policy": {
    "final_images_only": true,
    "final_name_suffix": "_final",
    "move_non_final_to_records": true,
    "allowed_final_extensions": [".png", ".jpg", ".jpeg", ".webp"]
  },
  "reference_image_role": "target_effect_for_reverse_engineering",
  "reference_fidelity_mode": "full_visual_replication",
  "preserve_reference_marketing_copy": true,
  "preserve_reference_promotional_copy": true,
  "preserve_reference_layout": true,
  "preserve_reference_props_and_effects": true,
  "auto_rewrite_reference_claims": false,
  "generation_input_mode": "own_product_only",
  "use_two_pass_composite": false,
  "repair_strategy": "refine_prompt_and_regenerate_5_0_pro",
  "auto_retry": {
    "enabled": true,
    "retry_on": ["REJECTED", "submit_failed", "query_failed", "generation_failed"],
    "max_retries_per_task": 2,
    "max_total_attempts_per_task": 3,
    "stop_on": ["PASSED", "PASSED_WITH_NOTES"],
    "announce_before_retry": true,
    "require_additional_confirmation": false,
    "preserve_generation_settings": true,
    "revise_only_failed_constraints": true,
    "stop_on_auth_or_compliance_error": true,
    "stop_on_insufficient_credit": true,
    "attempt_file_naming": true
  },
  "qa_policy": {
    "decision_levels": ["PASSED", "PASSED_WITH_NOTES", "REJECTED"],
    "blocking": ["product_count_and_geometry", "brand_and_primary_package_facts", "core_marketing_text", "composition_scene_and_style"],
    "advisory": ["unreadable_micro_package_text", "minor_non_core_decoration"]
  },
  "execution_log": {
    "enabled": true,
    "detail_level": "full",
    "per_task": true,
    "batch_summary": true
  },
  "default_canvas": {"aspect_ratio": "1:1", "width": 1024, "height": 1024},
  "default_output_format": "png",
  "platform": "pinduoduo",
  "purpose": "商品主图",
  "generation_engine": {
    "provider": "dreamina",
    "agent_mode": true,
    "command": "image2image",
    "executable": "dreamina",
    "model_version": "5.0Pro",
    "ratio": "1:1",
    "resolution_type": "1k",
    "generate_num": 1,
    "poll_seconds": 30,
    "download_results": true,
    "warn_before_credit_use": true,
    "save_submit_metadata": true,
    "input_mode": "own_product_only",
    "competitor_image_upload": false,
    "allow_model_fallback": false
  },
  "must_keep": [
    "目标效果图的画外促销与营销文案",
    "目标效果图的构图、数量关系、场景、道具和特效",
    "自有产品外形、品牌、包装、主文字、图案和颜色"
  ],
  "must_not_include": [
    "目标图参考产品包装替换自有产品包装",
    "未经确认的第三方事实",
    "额外商品",
    "水印",
    "二维码",
    "产品变形",
    "核心文案错字或乱码"
  ]
}
